# Line endings
#
# Every text file in this repository is stored with LF endings. Without this
# file, a Windows checkout with the default core.autocrlf=true rewrites them
# to CRLF in the working tree, so the same file differs between platforms for
# no benefit.
#
# The wildcard enforces LF for every text file, including the extensionless
# ones, so the working tree matches what the repository actually stores. The
# per-format rules below restate that intent for the documentation and
# configuration formats the project works in most.

* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Extensionless text files the repository carries.

.gitattributes text eol=lf
.gitignore   text eol=lf
LICENSE     text eol=lf

# Binary assets
#
# These are never text and must never be normalised or line-ending filtered.

*.png  binary
*.ico  binary
*.icns binary
*.exe  binary
*.dll  binary
*.zip  binary
