# Local Supabase Edge Function development only.
# Copy to website/supabase/.env.local and fill in placeholders.
# Never commit website/supabase/.env.local.

SUPABASE_URL=https://your-new-project-ref.supabase.co
SUPABASE_ANON_KEY=public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=server-only-test-secret
RAZORPAY_WEBHOOK_SECRET=server-only-webhook-secret
RAZORPAY_CURRENCY=USD